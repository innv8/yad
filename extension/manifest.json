{
  "manifest_version": 3,
  "name": "YAD Link",
  "short_name": "YAD Link",
  "version": "1.0.0",
  "description": "Send videos and files from Chrome to YAD, the download manager on your computer.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "YAD Link",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["webRequest", "downloads", "cookies", "scripting", "tabs", "contextMenus", "nativeMessaging", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/archivo-narrow-latin.woff2", "fonts/tenor-sans-latin.woff2"], "matches": ["<all_urls>"] }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
