{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yet another Downloader",
  "version": "2.0.1",
  "identifier": "ke.innv8.yad",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YAD",
        "width": 900,
        "height": 620,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false
      },
      {
        "label": "tray",
        "url": "tray.html",
        "title": "YAD",
        "width": 320,
        "height": 372,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
